# Server A production template. Keep the real file outside Git and inject values securely.
APP_ENV=production
PUBLIC_BASE_URL=https://anyendpoint.online
TRUST_PROXY=caddy
AUTH_ENABLED=true
GOOGLE_ISSUER_URL=https://accounts.google.com
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=inject-out-of-band
SESSION_SECRET=inject-at-least-32-random-bytes
KEY_PEPPER=inject-at-least-32-random-bytes
SESSION_COOKIE_NAME=__Host-cp_session
SECRET_BACKEND=external
DATABASE_URL=postgres://control_plane:replace-password@postgres:5432/control_plane?sslmode=disable
REDIS_URL=redis://redis:6379/0
WORKER_ALLOWED_HOSTS=10.10.0.2
WIREGUARD_CONTROL_PLANE_IP=10.10.0.1
GATEWAY_MAX_CONCURRENT=4
GATEWAY_TIMEOUT=300s
PLAYGROUND_REQUESTS_PER_MINUTE=10
MAX_BODY_BYTES=4194304
READ_HEADER_TIMEOUT=10s
READ_TIMEOUT=30s
WRITE_TIMEOUT=60s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s

# Production startup requires all five paths and MTLS_ENABLED=true.
MTLS_ENABLED=true
MTLS_CA_FILE=/run/secrets/worker-ca.pem
MTLS_SERVER_CERT_FILE=/run/secrets/control-plane-server.pem
MTLS_SERVER_KEY_FILE=/run/secrets/control-plane-server-key.pem
MTLS_CLIENT_CERT_FILE=/run/secrets/control-plane-client.pem
MTLS_CLIENT_KEY_FILE=/run/secrets/control-plane-client-key.pem

# PostgreSQL container bootstrap values. DATABASE_URL must use the same values.
POSTGRES_DB=control_plane
POSTGRES_USER=control_plane
POSTGRES_PASSWORD=inject-out-of-band
# Automatic private worker provisioning. Requires a separate Server B provisioner
# with the same secret, delivered out-of-band; never expose this value to users.
WORKER_PROVISIONING_ENABLED=false
WORKER_PROVISIONING_TOKEN=inject-at-least-32-random-bytes
WORKER_ENROLLMENT_TTL=10m
PROVIDER_LOGIN_TTL=10m