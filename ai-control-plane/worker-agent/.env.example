# One worker agent instance = one provider profile.
WORKER_PROVIDER=codex
CONTROL_PLANE_URL=https://control-plane:8081
WORKER_ENROLLMENT_TOKEN=enroll_one_time_value
WORKER_AGENT_ID=profile-specific-agent-001
WORKER_INTERNAL_URL=https://worker-codex:19080
WORKER_LISTEN_ADDR=0.0.0.0:19080
WORKER_CHILD_PORT=19081
WORKER_CHILD_COMMAND=/usr/local/bin/openai-api-server-via-codex
WORKER_DEFAULT_MODEL=gpt-6-luna
WORKER_TOKEN_FILE=/run/worker/worker-token
WORKER_HEARTBEAT_INTERVAL=20s
WORKER_SHUTDOWN_TIMEOUT=15s

# Codex: mount one writable auth home per profile.
CODEX_HOME=/run/provider/codex-home
CODEX_AUTH_JSON=/run/provider/codex-home/auth.json

# Claude Code alternative:
# WORKER_PROVIDER=claude_code
# WORKER_CHILD_COMMAND=/usr/local/bin/claude-api-server-via-claude-code
# CLAUDE_COMMAND=claude
# CLAUDE_CONFIG_DIR=/run/provider/claude-home

# mTLS material; all files must be mounted as runtime secrets.
MTLS_CA_FILE=/run/secrets/worker-ca.pem
MTLS_CLIENT_CERT_FILE=/run/secrets/worker-client.pem
MTLS_CLIENT_KEY_FILE=/run/secrets/worker-client-key.pem
WORKER_SERVER_CERT_FILE=/run/secrets/worker-server.pem
WORKER_SERVER_KEY_FILE=/run/secrets/worker-server-key.pem

# The provider login command/job channel is not implemented in this scaffold yet.
# It must be a fixed, reviewed provider command; never interpolate user input.
# WORKER_LOGIN_COMMAND=/usr/local/bin/codex-login
