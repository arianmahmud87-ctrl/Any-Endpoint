# development is intentionally permissive about optional dependencies.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
# Worker enrollment/heartbeat listener; never publish this port through the reverse proxy.
INTERNAL_HTTP_ADDR=127.0.0.1:8081
PUBLIC_BASE_URL=http://127.0.0.1:8080
WORKER_ALLOWED_HOSTS=127.0.0.1,localhost,worker
GATEWAY_MAX_CONCURRENT=10
GATEWAY_TIMEOUT=300s

# mTLS is optional locally but mandatory in production.
MTLS_ENABLED=false
MTLS_CA_FILE=
MTLS_SERVER_CERT_FILE=
MTLS_SERVER_KEY_FILE=
MTLS_CLIENT_CERT_FILE=
MTLS_CLIENT_KEY_FILE=
TRUST_PROXY=

# Set these in production. Never commit real values.
SESSION_SECRET=replace-with-at-least-32-random-bytes
KEY_PEPPER=replace-with-at-least-32-random-bytes
SECRET_BACKEND=local

# Phase 2 authentication is opt-in for local foundation work.
AUTH_ENABLED=false
GOOGLE_ISSUER_URL=https://accounts.google.com
GOOGLE_CLIENT_ID=
# Inject this from a secret manager; do not commit it.
GOOGLE_CLIENT_SECRET=
SESSION_COOKIE_NAME=cp_session
SESSION_TTL=12h
OAUTH_STATE_TTL=10m
WORKER_ENROLLMENT_TTL=10m

# When AUTH_ENABLED=true, the server performs authenticated startup pings and
# refuses to bind if PostgreSQL or Redis are unavailable.
DATABASE_URL=postgres://control_plane:change-me@postgres:5432/control_plane?sslmode=disable
REDIS_URL=redis://redis:6379/0

READ_HEADER_TIMEOUT=10s
READ_TIMEOUT=30s
WRITE_TIMEOUT=60s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s
MAX_BODY_BYTES=4194304
