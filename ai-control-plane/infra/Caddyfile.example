# Replace api.example.com with the real domain before deployment.
# Caddy obtains and renews the public certificate automatically.
api.example.com {
	@internal path /internal/*
	respond @internal 404

	reverse_proxy control-plane:8080
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
	}
}

# Build frontend with `npm run build` and mount its dist directory at /srv/frontend.
app.example.com {
	root * /srv/frontend
	try_files {path} /index.html
	file_server
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'"
	}
}
